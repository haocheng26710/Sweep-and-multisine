{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_count": {
      "maximum": 31,
      "minimum": 0,
      "type": "integer"
    },
    "authority_read_count": {
      "maximum": 20,
      "minimum": 0,
      "type": "integer"
    },
    "batch_id": {
      "const": "B1"
    },
    "checks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array"
    },
    "claim_ceiling": {
      "const": "BATCH_LOCAL_IDENTITY_COMPLETE_CAD_STATIC_AND_TECHNICAL_VALIDITY_ONLY"
    },
    "final_test_read": {
      "const": false
    },
    "record_kind": {
      "const": "INDEPENDENT_VERIFICATION"
    },
    "repair_id": {
      "const": "PRE-RELEASE-REPAIR-01"
    },
    "resealed": {
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "gen_enc_fast_b1_repair_01_independent_verification_v1"
    },
    "status": {
      "enum": [
        "PENDING_NON_SUCCESS",
        "PASS",
        "FAIL_CLOSED"
      ]
    },
    "task_id": {
      "const": "01a049a7-15ca-79e1-92a2-d3822ba8609d"
    },
    "verified_manifest_count": {
      "maximum": 4,
      "minimum": 0,
      "type": "integer"
    },
    "verified_member_count": {
      "maximum": 20,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "repair_id",
    "task_id",
    "batch_id",
    "run_id",
    "status",
    "verified_member_count",
    "verified_manifest_count",
    "authority_read_count",
    "artifact_count",
    "checks",
    "resealed",
    "claim_ceiling",
    "final_test_read"
  ],
  "type": "object"
}
