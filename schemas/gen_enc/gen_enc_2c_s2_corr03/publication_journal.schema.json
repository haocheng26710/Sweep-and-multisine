{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:gen-enc:2c:s2:corr03:publication-journal:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "dispatch_id", "release_full_sha256", "attestation_sha256", "run_id", "transaction_id", "state", "repository_root", "allowlist_path", "allowlist_sha256", "ordered_target_count", "verified_staging_sha256", "transaction_owned_temps", "published", "recovery_authorized", "final_test_read"],
  "properties": {
    "schema_version": {"const": "gen_enc_2c_s2_corr03_publication_journal_v1"}, "task_id": {"const": "01a048bd-dc5e-7e93-87e6-72d299ebaa4d"}, "dispatch_id": {"pattern": "^GEN-ENC-2C-S2-CORR03-RELEASE-[A-Z0-9-]+$"}, "release_full_sha256": {"$ref": "#/$defs/hash"}, "attestation_sha256": {"$ref": "#/$defs/hash"}, "run_id": {"$ref": "#/$defs/run"}, "transaction_id": {"type": "string", "pattern": "^tx-s2-corr03-[0-9a-f]{64}-[0-9]+$"}, "state": {"enum": ["PREPARED", "PUBLISHING", "COMMITTED", "ROLLED_BACK"]}, "repository_root": {"type": "string", "minLength": 1}, "allowlist_path": {"type": "string", "minLength": 1}, "allowlist_sha256": {"$ref": "#/$defs/hash"}, "ordered_target_count": {"const": 92}, "verified_staging_sha256": {"$ref": "#/$defs/hash"},
    "transaction_owned_temps": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["allowlist_index", "target_relative_path", "temp_absolute_path", "ownership_token_sha256", "created_by_transaction"], "properties": {"allowlist_index": {"type": "integer", "minimum": 0, "maximum": 91}, "target_relative_path": {"type": "string", "minLength": 1}, "temp_absolute_path": {"type": "string", "pattern": "\\.corr03-[0-9a-f]{64}-[0-9]+\\.tmp$"}, "ownership_token_sha256": {"$ref": "#/$defs/hash"}, "created_by_transaction": {"const": true}}}},
    "published": {"type": "array", "maxItems": 92, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["allowlist_index", "target_relative_path", "target_sha256", "preexisting"], "properties": {"allowlist_index": {"type": "integer", "minimum": 0, "maximum": 91}, "target_relative_path": {"type": "string", "minLength": 1}, "target_sha256": {"$ref": "#/$defs/hash"}, "preexisting": {"const": false}}}},
    "recovery_authorized": {"const": true}, "final_test_read": {"const": false}
  },
  "allOf": [{"if": {"properties": {"state": {"const": "ROLLED_BACK"}}, "required": ["state"]}, "then": {"properties": {"published": {"maxItems": 0}, "transaction_owned_temps": {"maxItems": 0}}}}, {"if": {"properties": {"state": {"const": "COMMITTED"}}, "required": ["state"]}, "then": {"properties": {"published": {"minItems": 92, "maxItems": 92}, "transaction_owned_temps": {"maxItems": 0}}}}],
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "run": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
