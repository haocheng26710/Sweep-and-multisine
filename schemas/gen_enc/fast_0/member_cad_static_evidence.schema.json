{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gen_enc_fast_0_member_cad_static_evidence_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "family_id", "member_id", "slot_ordinal", "authority_bindings", "ownership_cells", "slot_placements", "volume_root_witnesses", "u4_exception_witnesses", "general_minima", "exception_minima", "reduced_graph", "actual_fluid_graph", "random_zero_edge_witnesses", "static_status", "scientific_claim", "final_test_read"],
  "properties": {
    "schema_version": {"const": "gen_enc_fast_0_member_cad_static_evidence_v1"},
    "family_id": {"enum": ["HAND_DESIGNED", "NEAR_INDEPENDENT", "FIXED_SEED_RANDOM_DISORDERED", "PHYSICS_METAMATERIAL_INSPIRED"]},
    "member_id": {"type": "string", "minLength": 7},
    "slot_ordinal": {"type": "integer", "minimum": 1, "maximum": 20},
    "authority_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "ownership_cells": {"type": "array", "items": {"type": "object"}},
    "slot_placements": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"type": "object", "required": ["sector", "slot_id", "status", "coordinates"], "additionalProperties": true}},
    "volume_root_witnesses": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "u4_exception_witnesses": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"type": "object"}},
    "general_minima": {"type": "object", "required": ["minimum_feature_m", "minimum_load_path_m", "witness_ids"], "additionalProperties": false, "properties": {"minimum_feature_m": {"type": "number"}, "minimum_load_path_m": {"type": "number"}, "witness_ids": {"type": "array", "items": {"type": "string"}}}},
    "exception_minima": {"type": "object", "required": ["minimum_feature_m", "minimum_load_path_m", "witness_ids"], "additionalProperties": false, "properties": {"minimum_feature_m": {"type": "number"}, "minimum_load_path_m": {"type": "number"}, "witness_ids": {"type": "array", "items": {"type": "string"}}}},
    "reduced_graph": {"type": "object"},
    "actual_fluid_graph": {"type": "object"},
    "random_zero_edge_witnesses": {"type": "array", "items": {"type": "object"}},
    "static_status": {"enum": ["ELIGIBLE", "COST_INELIGIBLE", "TEMPLATE_VALIDITY_REJECTED", "FAIL_CLOSED"]},
    "scientific_claim": {"const": "NONE_BATCH_PARTIAL"},
    "final_test_read": {"const": false}
  },
  "$defs": {"binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "pointer"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "pointer": {"type": "string", "pattern": "^/"}}}}
}
