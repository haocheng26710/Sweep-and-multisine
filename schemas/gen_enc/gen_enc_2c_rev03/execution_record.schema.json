{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gen-enc:2c:rev03:execution-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "dispatch_id",
    "authorization_sha256",
    "source_manifest_sha256",
    "schema_manifest_sha256",
    "authority_manifest_sha256",
    "commands_exact",
    "runtime",
    "terminal_state",
    "observed_counts",
    "final_test_read"
  ],
  "properties": {
    "schema_version": {
      "const": "gen_enc_2c_execution_record_rev03_v1"
    },
    "task_id": {
      "type": "string"
    },
    "dispatch_id": {
      "type": "string"
    },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commands_exact": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "object"
    },
    "terminal_state": {
      "enum": [
        "SUCCESS",
        "FAIL_CLOSED"
      ]
    },
    "observed_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "final_test_read": {
      "const": false
    }
  },
  "x-addendum-metadata": {
    "new_content": "S1 frozen execution_record.schema.json",
    "related_legacy_files": [
      "outputs/gen_enc/GEN_ENC_2C_SCIENTIFIC_IDENTITY_GENERATION/phase_a_integration_rev03/future_execution_contract.json"
    ],
    "unchanged_content": "All legacy schemas, artifacts and scientific conclusions remain unchanged",
    "evidence_level": "E1_TECHNICAL_IMPLEMENTATION_CONFORMANCE_ONLY",
    "overrides": false
  }
}
